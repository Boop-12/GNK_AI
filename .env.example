APP_ENV=production
APP_NAME=GNK ALGO API
FRONTEND_URL=https://www.gnkalgo.com
CORS_ORIGINS=https://www.gnkalgo.com
# Generate independent random hex values on the Oracle VM. Never commit .env.
JWT_SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://app:SET_ON_VM@postgres:5432/gnkalgo
REDIS_URL=redis://redis:6379/0
JWT_ISSUER=https://www.gnkalgo.com
JWT_AUDIENCE=gnkalgo-web
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=14
RESET_TOKEN_MINUTES=20
COOKIE_SECURE=true
BROKER_TRADING_ENABLED=false
VALID_BROKERS=dhan,fyers,xts
REDIRECT_URL=
# Optional admin-owned token verification; ordinary users enter their own tokens.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
FYERS_APP_ID=
FYERS_ACCESS_TOKEN=
# Broker-provided HTTPS API root (or root ending in /marketdata); admin configured.
XTS_MARKET_DATA_BASE_URL=
XTS_MARKET_DATA_APP_KEY=
XTS_MARKET_DATA_SECRET_KEY=
XTS_INTERACTIVE_BASE_URL=
XTS_INTERACTIVE_APP_KEY=
XTS_INTERACTIVE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# AI remains unavailable until all three values below are configured.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Keep blank: browser requests use the same HTTPS origin through Nginx.
NEXT_PUBLIC_API_URL=
